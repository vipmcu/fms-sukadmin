# ==============================================================================
# FMS Sukadmin - Production Environment Variables Template
# คัดลอกไฟล์นี้เป็น .env.production หรือ .env ก่อนรัน `docker compose up -d`
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ฐานข้อมูล PostgreSQL สำหรับ Production (ใช้ใน docker-compose)
# ------------------------------------------------------------------------------
POSTGRES_USER=fms_admin
# แนะนำให้สุ่มรหัสผ่านความปลอดภัยสูง เช่น openssl rand -hex 16
POSTGRES_PASSWORD=replace_with_very_strong_db_password_123!
POSTGRES_DB=fms_production

# ------------------------------------------------------------------------------
# 2. ความปลอดภัยเซสชัน (AUTH_SECRET)
# สร้างคีย์สุ่ม 32-byte ผ่านคำสั่ง: openssl rand -base64 32
# ------------------------------------------------------------------------------
AUTH_SECRET=replace_with_openssl_rand_base64_32_string

# ------------------------------------------------------------------------------
# 3. URL ของระบบใน Production
# ------------------------------------------------------------------------------
APP_URL=http://localhost:3010

# ------------------------------------------------------------------------------
# 4. บัญชี Super Admin ครั้งแรก (Bootstrap Initial Admin)
# เมื่อเริ่ม Container ครั้งแรก ระบบจะสร้าง Super Admin ให้โดยอัตโนมัติ
# ------------------------------------------------------------------------------
BOOTSTRAP_ADMIN_EMAIL=superadmin@faculty.ac.th
BOOTSTRAP_ADMIN_PASSWORD=ReplaceWithStrongAdminPassword!2026

# ------------------------------------------------------------------------------
# 5. การส่งอีเมลแจ้งเตือน (SMTP Configuration)
# หากปล่อยว่าง ระบบจะพิมพ์ข้อมูลอีเมลลง Container Log แทน
# ------------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=FMS Faculty <no-reply@faculty.ac.th>

# ------------------------------------------------------------------------------
# 6. Single Sign-On (OAuth - ถ้ามี)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
